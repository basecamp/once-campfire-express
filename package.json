{
  "name": "once-campfire-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node bin/test.js",
    "build:assets": "node bin/build-assets.js",
    "format": "prettier --write src/*.js bin/*.js test/*.js",
    "format:check": "prettier --check src/*.js bin/*.js test/*.js",
    "bench:image": "docker build -t once-campfire-express:app --build-arg REVISION=$(git rev-parse HEAD) .",
    "bench:reads": "ruby bench/compare.rb --concurrencies 16 --routes room_show,messages_page,sidebar,search --duration 4 --output tmp/bench/results/reads",
    "bench:writes": "ruby bench/compare.rb --concurrencies 16 --routes post_message --duration 15 --output tmp/bench/results/writes",
    "bench:cable": "ruby bench/compare.rb --suites cable --cable-clients 100 --cable-tput-secs 0 --output tmp/bench/results/cable",
    "bench": "npm run bench:reads && npm run bench:writes && npm run bench:cable",
    "snapshot": "node bench/snapshot.js --labels ../once-campfire-rust/parity/.seed/default/labels.json --base http://127.0.0.1:25190 --out",
    "snapshot:compare": "node bench/snapshot.js --compare"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compressible": "2.0.18",
    "compression": "1.8.2",
    "eta": "4.6.0",
    "express": "5.2.1",
    "fresh": "2.0.0",
    "mime-types": "3.0.2",
    "multer": "2.4.0",
    "parse5": "8.0.1",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
