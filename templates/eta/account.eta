<%~ partials.layout_start(dot) %><section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
<% if (dot?.User?.Role == 1) { %><div class="align-center center avatar__form gap" data-controller="upload-preview"><form class="txt--medium" data-controller="form" method="post" enctype="multipart/form-data" action="/account"><input type="hidden" name="_method" value="patch"><label class="btn input--file"><img src="<%= asset("camera.svg") %>" aria-hidden="true" width="20" height="20"><input type="file" name="account[logo]" class="input" accept="image/*" data-action="upload-preview#previewImage change->form#submit"><span class="for-screen-reader">Upload logo</span></label></form><form data-controller="form" method="post" enctype="multipart/form-data" action="/account"><input type="hidden" name="_method" value="patch"><label class="btn avatar input--file account-logo txt-xx-large"><img src="/account/logo?v=<%= versionTime(dot?.Account?.UpdatedAt) %>" role="presentation" width="48" height="48" data-upload-preview-target="image"><input type="file" name="account[logo]" class="input" accept="image/*" data-action="upload-preview#previewImage change->form#submit"><span class="for-screen-reader">Upload logo</span></label></form><% if (dot?.Account?.HasLogo) { %><form class="button_to" method="post" action="/account/logo"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative txt-small avatar__delete-btn" type="submit"><img src="<%= asset("minus.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Delete logo</span></button></form><% } %></div>
<form data-controller="form" class="flex flex-column gap" method="post" action="/account"><input type="hidden" name="_method" value="patch"><div class="flex align-center gap"><%= translate("account_name") %><label class="flex align-center gap flex-item-grow"><input name="account[name]" value="<%= dot?.Account?.Name %>" id="account_name" class="input txt-large" autocomplete="off" placeholder="Name this account" autofocus data-action="keydown.enter->form#submit"></label><button class="btn btn--reversed center" type="submit"><img src="<%= asset("check.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Save changes</span></button></div></form>
<div class="margin-block-start pad-block pad-inline-double fill-shade border-radius"><form data-controller="form" class="flex align-center gap center" method="post" action="/account"><input type="hidden" name="_method" value="put"><div class="flex-item-grow flex align-center gap txt-align-start"><img src="<%= asset("crown.svg") %>" class="colorize--black" aria-hidden="true" width="18" height="18"> Must be admin to create new rooms</div><input type="hidden" name="account[settings][restrict_room_creation_to_administrators]" value="<% if (dot?.Account?.RestrictRooms) { %>false<% } else { %>true<% } %>"><label class="switch"><input type="checkbox" class="switch__input" <% if (dot?.Account?.RestrictRooms) { %>checked<% } %> data-action="change->form#submit"><span class="switch__btn round"></span><span class="for-screen-reader">Must be admin to create new rooms</span></label></form></div>
<% } else { %><figure class="account-logo avatar txt-xx-large center"><img src="/account/logo" alt="Account logo" width="300" height="300"></figure><h1 class="flex-item-grow txt-x-large"><%= dot?.Account?.Name %></h1><% } %>
<div class="margin-block pad-inline pad-block-start fill-shade border-radius"><%~ partials.invite(dot) %><hr class="margin-block separator full-width" style="--border-style: solid"><menu class="flex flex-column gap margin-none pad"><turbo-frame id="account_users"><%~ partials.account_administrators(dot) %><% if ((dot?.Administrators && dot?.Users)) { %><hr class="separator full-width" style="--border-style: solid"><% } %><%~ partials.account_users(dot) %><%~ partials.account_next_page(dot) %></turbo-frame></menu></div>
</section><%~ partials.layout_end(dot) %>