<%~ partials.layout_start(dot) %><section class="panel panel--wide flex flex-column gap"><h1 class="txt-align-center txt-large margin-none">Push Notification Subscriptions</h1><div class="pad-inline fill-shade border-radius" id="push_subscriptions"><menu class="pad flex flex-column gap"><% for (const item1 of each(dot?.Subscriptions)) { %><li class="flex flex-column margin-none membership-item"><span class="overflow-ellipsis txt-primary txt-undecorated"><% const userAgent = agent(item1?.UserAgent) %><strong><%= userAgent?.Browser?.Text %> <%= userAgent?.Version?.Text %> on <%= userAgent?.Platform?.Text %></strong><br></span><span class="flex align-start gap txt-small"><span><%= item1?.Endpoint %></span><span class="flex align-center gap"><form method="post" action="/users/me/push_subscriptions/<%= item1?.ID %>/test_notifications"><button class="btn btn--reversed"><img src="<%= asset("notification-bell-everything.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Send test notification</span></button></form><form method="post" action="/users/me/push_subscriptions/<%= item1?.ID %>"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative"><img src="<%= asset("minus.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Delete subscription</span></button></form></span></span></li><% } %></menu></div></section><%~ partials.layout_end(dot) %>