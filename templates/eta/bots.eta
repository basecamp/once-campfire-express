<%~ partials.layout_start(dot) %><section class="panel panel--wide txt-align-center flex flex-column position-relative" style="view-transition-name: chat-bots"><div class="flex align-center gap"><div class="panel__button"><%= translate("chat_bots") %></div><div class="pad-inline-double center"><h1 class="margin-none">Chat bots</h1><p class="margin-none-block-start">With Chat bots, other sites and services can post updates directly to Campfire.</p><a href="/account/bots/new" class="btn btn--reversed txt-large" aria-label="Add a chat bot"><img src="<%= asset("bot.svg") %>" aria-hidden="true" width="20" height="20"><img src="<%= asset("add.svg") %>" aria-hidden="true" width="20" height="20"></a></div></div>
<div class="pad-inline pad-block-start"><menu class="flex flex-column gap margin-none pad"><% for (const item1 of each(dot?.Bots)) { %><% const bot = item1?.User %><li class="flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double"><div class="flex align-center gap"><figure class="avatar flex-item--no-shrink" style="--avatar-size: 2.65em;"><a title="<%= item1?.User?.Title %>" class="btn avatar" data-turbo-frame="_top" href="/users/<%= item1?.User?.ID %>"><img src="<%= avatar(item1?.User?.ID, item1?.User?.UpdatedAt) %>" aria-hidden="true" width="48" height="48"></a></figure><div class="min-width"><div class="overflow-ellipsis txt-large"><strong><%= item1?.User?.Name %></strong></div></div><a href="/account/bots/<%= item1?.User?.ID %>/edit" class="btn flex-item-justify-end" style="view-transition-name: chat-bot-<%= item1?.User?.ID %>"><img src="<%= asset("pencil.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Edit <%= item1?.User?.Name %></span></a></div>
<% for (const item2 of each(item1?.Rooms)) { %><fieldset class="gap max-width pad border border-radius"><legend class="min-width txt-align-start pad-inline"><strong class="overflow-ellipsis"><%= item2?.Name %></strong></legend><% const text = botCommand(dot?.Origin, item2?.ID, bot?.BotKey, false) %><% const upload = botCommand(dot?.Origin, item2?.ID, bot?.BotKey, true) %>
<div class="flex align-center gap"><img src="<%= asset("messages-outlined.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"><div class="flex-item-grow"><input type="text" class="input full-width fill-white" value="<%= text %>" aria-label="curl command for posting messages" readonly></div><div class="txt-small"><button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= text %>"><img src="<%= asset("copy-paste.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Copy message command</span></button></div></div>
<div class="flex align-center gap"><img src="<%= asset("attachment.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"><div class="flex-item-grow"><input type="text" class="input full-width fill-white" value="<%= upload %>" aria-label="curl command for posting attachments" readonly></div><div class="txt-small"><button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= upload %>"><img src="<%= asset("copy-paste.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Copy attachment command</span></button></div></div>
</fieldset><% } %></li><% } %></menu></div></section><%~ partials.layout_end(dot) %>