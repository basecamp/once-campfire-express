<%~ partials.layout_start(dot) %>
<section class="panel flex flex-column gap" style="view-transition-name: avatar-<%= dot?.User?.ID %>">
<%~ partials.install_instructions(dot) %>
<div class="align-center center avatar__form gap" data-controller="upload-preview">
<form class="txt-medium" data-controller="form" enctype="multipart/form-data" action="/users/me/profile" method="post"><input type="hidden" name="_method" value="patch"><label class="btn input--file"><img src="<%= asset("camera.svg") %>" aria-hidden="true" width="20" height="20"><input type="file" name="user[avatar]" id="file" class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage change->form#submit"><span class="for-screen-reader">Upload avatar</span></label></form>
<form data-controller="form" enctype="multipart/form-data" action="/users/me/profile" method="post"><input type="hidden" name="_method" value="patch"><label class="btn avatar input--file txt-xx-large"><img src="<%= avatar(dot?.User?.ID, dot?.User?.UpdatedAt) %>" aria-hidden="true" width="300" height="300" data-upload-preview-target="image"><input type="file" name="user[avatar]" id="file" class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage change->form#submit"><span class="for-screen-reader">Avatar</span></label></form>
<% if (dot?.AvatarAttached) { %><form class="button_to" method="post" action="/users/<%= dot?.User?.ID %>/avatar"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative txt-small avatar__delete-btn" type="submit"><img src="<%= asset("minus.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Delete avatar</span></button></form><% } %>
</div>
<form data-controller="form" action="/users/me/profile" method="post"><input type="hidden" name="_method" value="patch"><div class="flex flex-column gap">
<div class="flex align-center gap"><%= translate("user_name") %><label class="flex align-center gap flex-item-grow input input--actor"><input name="user[name]" id="user_name" value="<%= dot?.User?.Name %>" class="input txt-large" autocomplete="name" placeholder="Enter your name" autofocus required data-1p-ignore="true"><img src="<%= asset("person.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div>
<div class="flex align-center gap"><%= translate("email_address") %><label class="flex align-center gap flex-item-grow input input--actor"><input type="email" name="user[email_address]" id="user_email_address" value="<%= dot?.User?.Email %>" class="input txt-large" autocomplete="username" placeholder="Enter your email address"><img src="<%= asset("email.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div>
<div class="flex align-center gap"><%= translate("update_password") %><label class="flex align-center gap flex-item-grow input input--actor"><input type="password" name="user[password]" id="user_password" class="input txt-large" autocomplete="new-password" placeholder="Change password" maxlength="72"><img src="<%= asset("password.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div>
<div class="flex align-start gap"><%= translate("bio") %><label class="flex align--center gap flex-item--grow input input--actor"><textarea name="user[bio]" id="user_bio" class="input txt-large" placeholder="A few words about yourself…" maxlength="200" rows="3"><%= dot?.User?.Bio %></textarea><img src="<%= asset("bio.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div>
<button class="btn btn--reversed center txt-large" type="submit"><img src="<%= asset("check.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Save changes</span></button>
</div></form>
<div class="margin-block pad-inline pad-block fill-shade border-radius"><menu class="flex flex-column gap margin-none pad"><% for (const item1 of each(dot?.Memberships)) { %><li class="flex align-center gap margin-none min-width membership-item"><a href="/rooms/<%= item1?.Room?.ID %>" class="overflow-ellipsis fill-shade txt-primary txt-undecorated"><strong><%= item1?.Room?.Name %></strong></a><hr class="separator" aria-hidden="true"><span class="txt-small"><%~ partials.involvement(item1) %></span></li><% } %><% if ((dot?.Memberships && dot?.DirectMemberships)) { %><hr class="separator full-width" style="--border-style: solid"><% } %><% for (const item2 of each(dot?.DirectMemberships)) { %><li class="flex align-center gap margin-none min-width membership-item"><a href="/rooms/<%= item2?.Room?.ID %>" class="overflow-ellipsis fill-shade txt-primary txt-undecorated"><strong><%= item2?.Room?.Name %></strong></a><hr class="separator" aria-hidden="true"><span class="txt-small"><%~ partials.involvement(item2) %></span></li><% } %></menu></div>
<%~ partials.transfer_link(dot) %>
</section><%~ partials.layout_end(dot) %>