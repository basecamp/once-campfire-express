<%~ partials.layout_start(dot) %><turbo-frame id="user_sidebar" data-turbo-permanent="true" target="_top" data-controller="rooms-list read-rooms turbo-frame" data-rooms-list-unread-class="unread" data-action="presence:present@window->rooms-list#read read-rooms:read->rooms-list#read turbo:frame-load->rooms-list#loaded refresh-room:visible@window->turbo-frame#reload">
<turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= dot?.RoomsStream %>"></turbo-cable-stream-source><turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="<%= dot?.UserRoomsStream %>"></turbo-cable-stream-source>
<div class="sidebar__container overflow-y overflow-hide-scrollbar" data-controller="badge-dot" data-badge-dot-unread-class="unread" data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
<turbo-frame id="direct_rooms_control" target="_top"><div class="directs gap overflow-x overflow-hide-scrollbar"><a class="direct direct__new" data-turbo-frame="_self" href="/rooms/directs/new"><span class="avatar avatar--icon"><img src="<%= asset("messages-add.svg") %>" width="20" height="20" aria-hidden="true" class="colorize--black"></span><span class="direct__author flex max-width min-width border-radius pad-inline-half"><span class="for-screen-reader">New</span><span class="txt-small overflow-clip">Ping</span></span></a><div id="direct_rooms" contents data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem"><% for (const item1 of each(dot?.SidebarRooms)) { %><% if (item1?.Type == "Rooms::Direct") { %><%~ item1.Fragment %><% } %><% } %></div><div contents><% for (const item2 of each(dot?.Placeholders)) { %><form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%= item2?.ID %>"><button class="direct borderless fill-transparent unpad"><span class="avatar"><img src="<%= avatar(item2?.ID, item2?.UpdatedAt) %>" aria-hidden="true"></span><span class="direct__author flex align-center gap max-width min-width border-radius txt-small"><span class="txt-nowrap overflow-ellipsis"><span class="for-screen-reader">Start a ping with</span><%= firstName(item2?.Name) %></span></span></button></form><% } %></div></div></turbo-frame>
<div class="rooms position-relative flex flex-column gap"><div id="shared_rooms" contents data-controller="sorted-list"><% for (const item3 of each(dot?.SidebarRooms)) { %><% if (item3?.Type != "Rooms::Direct") { %><%~ partials.sidebar_shared(item3) %><% } %><% } %></div><% if (dot?.CanCreateRooms) { %><a class="rooms__new-btn btn room align-center gap txt-reversed" aria-label="New Chat Room" href="/rooms/opens/new"><img src="<%= asset("add.svg") %>" width="20" height="20" aria-hidden="true" style="view-transition-name: new-room"></a><% } %></div>
<button class="btn sidebar__toggle" data-action="toggle-class#toggle"><img src="<%= asset("menu.svg") %>" width="20" height="20" aria-hidden="true"><span class="for-screen-reader">Open menu</span></button></div>
<div class="flex align-end sidebar__tools gap justify-end"><a class="btn avatar flex-item-no-shrink sidebar__tool" href="/users/me/profile"><img src="<%= avatar(dot?.User?.ID, dot?.User?.UpdatedAt) %>" width="48" height="48" aria-hidden="true" style="view-transition-name: avatar-<%= dot?.User?.ID %>"><span class="for-screen-reader">My Settings</span></a><a class="btn align-center gap txt-reversed sidebar__tool" href="/account/edit"><img src="<%= asset("settings.svg") %>" width="20" height="20" aria-hidden="true" style="view-transition-name: account-settings"><span class="for-screen-reader">Account Settings</span></a></div></turbo-frame><%~ partials.layout_end(dot) %>
