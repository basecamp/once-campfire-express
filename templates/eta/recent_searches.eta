<% for (const item1 of each(dot?.RecentSearches)) { %><a class="align-center gap room btn txt-nowrap" href="/searches?q=<%= item1 %>"><span class="overflow-ellipsis">“<%= item1 %>”</span></a><% } %><% if (dot?.RecentSearches) { %><form class="button_to" method="post" action="/searches/clear"><input type="hidden" name="_method" value="delete"><button class="btn searches__btn" data-turbo-confirm="Are you sure you want to clear your recent searches?" type="submit"><img aria-hidden="true" src="<%= asset("broom.svg") %>"><span class="for-screen-reader">Clear recent searches</span></button></form><% } %>