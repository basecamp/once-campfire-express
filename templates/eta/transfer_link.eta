<fieldset><legend class="gap"><img src="<%= asset("laptop.svg") %>" aria-hidden="true" width="36" height="36" class="colorize--black"><img src="<%= asset("transfer.svg") %>" aria-hidden="true" width="36" height="36" class="colorize--black"><img src="<%= asset("mobile-phone.svg") %>" aria-hidden="true" width="36" height="36" class="colorize--black"></legend><div class="flex flex-column gap"><% if ((dot?.Subject?.ID && (dot?.Subject?.ID != dot?.User?.ID))) { %><div class="flex align-center gap justify-center"><img src="<%= asset("crown.svg") %>" aria-hidden="true" width="16" height="16" class="flex-item-no-shrink colorize--black"><label for="session_transfer_url">Share to get them back into their account</label></div><% } else { %><label for="session_transfer_url" class="for-screen-reader">Use this link to login automatically on another device</label><% } %><input type="text" class="input" value="<%= dot?.Transfer %>" id="session_transfer_url" readonly><div class="flex align-center center gap"><a href="<%= qrpath(dot?.Transfer) %>" class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="<%= qrpath(dot?.Transfer) %>"><span class="for-screen-reader">Show auto-login QR code</span><img src="<%= asset("qr-code.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"></a><button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= dot?.Transfer %>"><span class="for-screen-reader">Copy auto-login link</span><img src="<%= asset("copy-paste.svg") %>" aria-hidden="true" width="20" height="20" class="flex-item-no-shrink colorize--black"></button><button class="btn" hidden data-controller="web-share" data-action="web-share#share" data-web-share-url-value="<%= dot?.Transfer %>" data-web-share-title-value="Your sign-in link" data-web-share-text-value="This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out."><span class="for-screen-reader">Share auto-login link</span><img src="<%= asset("share.svg") %>" aria-hidden="true" width="20" height="20" class="flex-item-no-shrink colorize--black"></button></div></div></fieldset>