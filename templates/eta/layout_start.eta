<% if (dot?.Frame) { %><html><head></head><body><% } else { %><!DOCTYPE html>
<html><head>
<title><% if (dot?.Title) { %><%= dot?.Title %><% } else { %>Campfire<% } %></title>
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
<meta name="view-transition" content="same-origin"><meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<% if (dot?.User?.ID) { %><meta name="current-user-id" content="<%= dot?.User?.ID %>"><meta name="current-user-name" content="<%= dot?.User?.Name %>"><% } %>
<meta name="action-cable-url" content="/cable"><meta name="vapid-public-key" content="<%= dot?.VAPIDPublicKey %>"><meta name="turbo-prefetch" content="true">
<link rel="manifest" href="/webmanifest.json"><link rel="icon" href="/account/logo?v=<%= versionTime(dot?.Account?.UpdatedAt) %>" type="image/png"><link rel="apple-touch-icon" href="/account/logo?v=<%= versionTime(dot?.Account?.UpdatedAt) %>">
<%= stylesheets() %><%= dot?.CustomStyles %><%= importmap() %>
<% if (dot?.Reload) { %><meta name="turbo-visit-control" content="reload"><% } %>
<% if (dot?.Chat) { %><meta name="turbo-cache-control" content="no-preview"><meta name="current-room-id" content="<%= dot?.Room?.ID %>"><% } %>
</head><body class="<%= dot?.BodyClass %><% if (dot?.User?.Role == 1) { %> admin<% } %><% if (dot?.Account?.HasLogo) { %> account-has-logo<% } %>" data-controller="local-time lightbox">
<a href="#main-content" class="skip-navigation btn">Skip to main content</a>
<nav id="nav"><% if (dot?.Screen == "join") { %><div class="flex-item-justify-end"><a href="/session/new" class="btn flex-item-justify-end"><img src="<%= asset("login-keys.svg") %>" aria-hidden="true"><span class="for-screen-reader">Sign in</span></a></div><% } %><% if (dot?.Screen == "user") { %><div class="flex-item-justify-start"><a href="/" class="btn"><img src="<%= asset("arrow-left.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Go Back</span></a></div><% if (dot?.User?.ID == dot?.Subject?.ID) { %><div class="flex align-center gap flex-item-justify-end"><a href="/users/me/profile" class="btn"><img src="<%= asset("pencil.svg") %>" aria-hidden="true"><span class="for-screen-reader">Edit my profile</span></a></div><% } %><% } %><% if ((((dot?.Screen == "bots") || (dot?.Screen == "custom-styles")) || (dot?.Screen == "bot-form"))) { %><div class="flex-item-justify-start"><a class="btn" href="<% if (dot?.Screen == "bot-form") { %>/account/bots<% } else { %>/account/edit<% } %>"><img src="<%= asset("arrow-left.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Go Back</span></a></div><% } %><% if (((dot?.Screen == "push-subscriptions") || (((dot?.Screen == "room-form") && ((dot?.Room?.ID || (dot?.Room?.Type != "Rooms::Direct"))))))) { %><div class="flex-item-justify-start"><a class="btn" href="<%= dot?.BackPath %>"><img src="<%= asset("arrow-left.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Go Back</span></a></div><% } %><% if (dot?.Screen == "account") { %><%~ partials.account_nav(dot) %><% } %><% if (dot?.Screen == "profile") { %><%~ partials.profile_nav(dot) %><% } %><% if (dot?.Screen == "search") { %><%~ partials.search_nav(dot) %><% } %><% if (dot?.Chat) { %><% if (dot?.Account?.HasLogo) { %><figure class="account-logo avatar"><img src="/account/logo?v=<%= versionTime(dot?.Account?.UpdatedAt) %>" alt="Account logo" width="300" height="300"></figure><% } %><span class="btn btn--reversed btn--faux room--current"><h1 class="room__contents txt-medium overflow-ellipsis"><% if (dot?.Room?.Type == "Rooms::Direct") { %><span class="for-screen-reader">Ping with </span><% } %><%= dot?.Room?.Name %></h1></span>
<a class="btn" style="view-transition-name: edit-room-<%= dot?.Room?.ID %>" data-room-id="<%= dot?.Room?.ID %>" href="<%= dot?.Room?.EditPath %>"><img aria-hidden="true" src="<%= asset("menu-dots-horizontal.svg") %>" width="20" height="20"><span class="for-screen-reader">Settings for this <%= dot?.Room?.Noun %></span></a>
<%~ partials.notification_bell(dot) %><% } %></nav>
<% if ((dot?.Notice || dot?.Error)) { %><div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove"><div class="flash__inner shadow"<% if (dot?.Error) { %> style="--flash-background: var(--color-negative)"<% } %>><img src="<% if (dot?.Error) { %><%= asset("alert.svg") %><% } else { %><%= asset("check.svg") %><% } %>" aria-hidden="true" width="24" height="24" class="colorize--white"></div><span class="for-screen-reader" role="alert" aria-atomic="true"><% if (dot?.Notice) { %><%= dot?.Notice %><% } else { %><%= dot?.Error %><% } %></span></div><% } %>
<main id="main-content"><% } %>