<div class="panel txt-align-center"><section class="directs--edit margin-block-end"><% const page = dot %><% for (const item2 of each(dot?.Users)) { %><% if (get(page?.Selected, item2?.ID)) { %><div class="member flex flex-column gap fill-shade pad border-radius"><figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch"><a title="<%= item2?.Title %>" class="btn avatar" data-turbo-frame="_top" href="/users/<%= item2?.ID %>"><img aria-hidden="true" loading="lazy" src="<%= avatar(item2?.ID, item2?.UpdatedAt) %>" width="48" height="48"></a></figure><strong><%= item2?.Name %></strong></div><% } %><% } %></section><form class="button_to" method="post" action="/rooms/directs/<%= dot?.Room?.ID %>"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative center" aria-label="Delete Ping" data-turbo-confirm="Are you sure you want to delete this ping and all messages in it? This can’t be undone." type="submit"><img aria-hidden="true" src="<%= asset("trash.svg") %>">Ping</button></form></div>