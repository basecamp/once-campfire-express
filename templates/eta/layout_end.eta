<% if (dot?.Frame) { %></body></html><% } else { %><footer id="footer"><% if (dot?.Chat) { %><%~ partials.composer(dot) %><% } else if (dot?.Screen == "search") { %><%~ partials.search_composer(dot) %><% } else if (dot?.Screen == "account") { %><div class="txt-align-center center margin-block-double txt-subtle">Campfire&trade; version <span class="version-badge"><%= dot?.Version %></span></div><% } %></footer></main>
<aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open"><% if (dot?.Screen == "search") { %><div class="rooms position-relative flex flex-column gap overflow-y overflow-hide-scrollbar"><%~ partials.recent_searches(dot) %></div><% } else if ((dot?.Chat || (dot?.Screen == "welcome"))) { %><turbo-frame id="user_sidebar" src="/users/me/sidebar" data-turbo-permanent="true" target="_top" data-controller="rooms-list read-rooms turbo-frame" data-rooms-list-unread-class="unread" data-action="presence:present@window->rooms-list#read read-rooms:read->rooms-list#read turbo:frame-load->rooms-list#loaded refresh-room:visible@window->turbo-frame#reload"></turbo-frame><% } %></aside>
<%~ partials.lightbox(dot) %>
<a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page"><img alt="Campfire logo" src="<%= asset("campfire-icon.png") %>" width="256" height="216"></a>
</body></html><% } %>