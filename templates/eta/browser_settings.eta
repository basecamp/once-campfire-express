<% if (!((((dot?.Platform?.Safari || dot?.Platform?.Chrome)) && dot?.Platform?.IOS))) { %>  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      <img src="<%= asset("external/web.svg") %>" aria-hidden="true" width="20" height="20">
      <strong>Check your <%= dot?.Platform?.Browser %> settings</strong>
      <img src="<%= asset("disclosure.svg") %>" aria-hidden="true" class="disclosure" width="10" height="10">
    </summary>

<% if ((dot?.Platform?.Firefox && dot?.Platform?.Android)) { %>        <ol>
          <li>Tap <em><img src="<%= asset("lock.svg") %>" alt="the View site information button" width="20" height="20"></em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
<% } else if ((dot?.Platform?.Edge && dot?.Platform?.Desktop)) { %>        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em><img src="<%= asset("lock.svg") %>" alt="the View site information button" width="20" height="20"></em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= dot?.Platform?.Browser %>.</h2>
        <ol>
<% if (dot?.Platform?.Windows) { %>            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> <em>ON</em> for <%= dot?.Platform?.Browser %>.</li>
<% } else { %>            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= dot?.Platform?.Browser %></em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
<% } %>        </ol>
<% } else if ((dot?.Platform?.Firefox && dot?.Platform?.Desktop)) { %>        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em><%= dot?.Platform?.Browser %></em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em><%= dot?.Origin %>/</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= dot?.Platform?.Browser %>.</h2>
        <ol>
<% if (dot?.Platform?.Windows) { %>            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the toggle button" width="22" height="22"></em> <em>ON</em> for <%= dot?.Platform?.Browser %>.</li>
<% } else { %>            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= dot?.Platform?.Browser %></em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
<% } %>        </ol>
<% } else if ((dot?.Platform?.Chrome && dot?.Platform?.Desktop)) { %>        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em><img src="<%= asset("external/sliders.svg") %>" alt="View site information" width="20" height="20"></em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= dot?.Platform?.Browser %>.</h2>
        <ol>
<% if (dot?.Platform?.Windows) { %>            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> <em>ON</em> for <%= dot?.Platform?.Browser %>.</li>
<% } else { %>            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= dot?.Platform?.Browser %></em>.</li>
            <li>Click <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
<% } %>        </ol>
<% } else if ((dot?.Platform?.Chrome && dot?.Platform?.Android)) { %>        <ol>
          <li>Tap the <em><img src="<%= asset("menu-dots-vertical.svg") %>" alt="More options" width="16" height="16"></em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> to <em>Allow <%= dot?.Platform?.Browser %> notifications</em>.</li>
          <li>Tap <em><img src="<%= asset("external/switch.svg") %>" alt="the switch" width="22" height="22"></em> next to <em>Web apps</em>.</li>
          <li>Tap <em><img src="<%= asset("notification-bell-alert.svg") %>" alt="the notification bell" width="16" height="16"></em> and select <em>Allow</em>.</li>
        </ol>
<% } else if ((dot?.Platform?.Safari && dot?.Platform?.Desktop)) { %>        <ol>
          <li>Click <em><%= dot?.Platform?.Browser %></em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em><%= dot?.Origin %>/</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
<% } else { %>        <p>Ensure notifications are enabled for <em><%= dot?.Origin %>/</em> in your web browser settings.</p>
<% } %>  </details>
<% } %>
