<% if (!((dot?.Platform?.Chrome || ((dot?.Platform?.Firefox && (!dot?.Platform?.Android)))))) { %>
<details class="notifications-help pwa__instructions hide-in-pwa" data-controller="pwa-install" data-pwa-install-prompting-class="pwa--can-install" data-notifications-target="details"><summary class="btn"><img src="<%= asset("external/install.svg") %>" aria-hidden="true" width="20" height="20"><strong>Install Campfire as a web app.</strong><img src="<%= asset("disclosure.svg") %>" aria-hidden="true" width="10" height="10" class="disclosure"></summary>
<% if (dot?.Platform?.Edge) { %><ol><li>Click <em><img src="<%= asset("install-edge.svg") %>" alt="the app available - install Campfire chat button" width="16" height="16"></em>in the address bar.</li><li>Click <em>Install</em>.</li></ol>
<% } else if ((dot?.Platform?.Chrome && dot?.Platform?.Android)) { %><ol><li>Tap the <em><img src="<%= asset("menu-dots-vertical.svg") %>" alt="More options" width="16" height="16"></em> menu button.</li><li>Tap <em>Install app</em> in the menu.</li></ol>
<% } else if ((dot?.Platform?.Firefox && dot?.Platform?.Android)) { %><ol><li>Tap the <em><img src="<%= asset("menu-dots-vertical.svg") %>" alt="More options" width="16" height="16"></em> menu button.</li><li>Tap <em>Install</em> in the menu.</li></ol>
<% } else if ((dot?.Platform?.Safari && dot?.Platform?.Desktop)) { %><ol><li>Click <em>File</em> in the top left.</li><li>Click <em>Add to Dock…</em>.</li></ol>
<% } else if ((((dot?.Platform?.Safari || dot?.Platform?.Chrome)) && dot?.Platform?.IOS)) { %><p>To receive push notifications in <%= dot?.Platform?.Browser %> for <%= dot?.Platform?.OperatingSystem %>, you must install Campfire as a web app.</p><ol><li>Tap <em><img src="<%= asset("external/share.svg") %>" alt="the share button" width="20" height="20"></em></li><li>Tap <em>Add to Home Screen</em>.</li></ol>
<% } else { %><p>Some platforms require you to install Campfire as a web app to receive push notifications.</p><% } %>
<div class="margin-block-start txt-align-center pwa__installer"><hr class="separator margin-block"><button class="btn btn--reversed center" data-action="pwa-install#promptInstall"><img src="<%= asset("external/install.svg") %>" aria-hidden="true">Install now</button></div></details><% } %>