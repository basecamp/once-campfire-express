<%~ partials.layout_start(dot) %><% const user = dot?.User %><% for (const item2 of each(dot?.Messages)) { %><turbo-frame id="new_boost_message_<%= item2?.ClientID %>"><div class="boost flex-inline postion--relative max-width fill-white" style="--column-gap: var(--inline-space-half)"><form class="boost__form flex align-center gap expanded" data-controller="form scroll-into-view" data-turbo-frame="boosting_message_<%= item2?.ClientID %>" data-action="keydown.esc-&gt;form#cancel" action="/messages/<%= item2?.ID %>/boosts" accept-charset="UTF-8" method="post"><label class="boost__form-label flex gap" style="--column-gap: 0.7ch;" role="button" tabindex="0" aria-label="Add a boost"><figure class="avatar boost__avatar flex-item-no-shrink"><a title="<%= user?.Name %>" class="btn avatar" data-turbo-frame="_top" href="/users/<%= user?.ID %>"><img aria-hidden="true" src="<%= avatar(user?.ID, user?.UpdatedAt) %>" width="48" height="48"></a><span class="for-screen-reader"><%= user?.Name %></span></figure><input autofocus="autofocus" autocomplete="off" autocorrect="off" maxlength="16" required="required" pattern="\S+.*" data-boost-form-target="input" class="input input--boost txt-small" size="16" type="text" name="boost[content]"></label><button name="button" type="submit" class="btn btn--reversed"><img aria-hidden="true" src="<%= asset("check.svg") %>"><span class="for-screen-reader">Submit</span></button><a data-turbo-frame="boosts_message_<%= item2?.ClientID %>" data-form-target="cancel" class="btn btn--negative" href="/messages/<%= item2?.ID %>/boosts"><img aria-hidden="true" src="<%= asset("minus.svg") %>"><span class="for-screen-reader">Cancel</span></a></form></div></turbo-frame><% } %><%~ partials.layout_end(dot) %>