<%~ partials.layout_start(dot) %><form action="/join/<%= dot?.JoinCode %>" method="post" enctype="multipart/form-data" class="center"><section class="nametag u-relative"><div class="flex justify-center align-center pad-block"><img src="<%= asset("lanyard.svg") %>" class="nametag__lanyard" aria-hidden="true"></div><div class="nametag__inner flex flex-column gap"><fieldset class="flex flex-column center-block"><legend class="txt-align-center flex gap"><figure class="account-logo avatar"><img src="/account/logo" alt="Account logo" width="300" height="300"></figure><strong class="txt-large"><%= dot?.Account?.Name %></strong></legend><label class="align-center center avatar__form gap" data-controller="upload-preview"><div class="btn input--file"><img src="<%= asset("camera.svg") %>" aria-hidden="true"><input type="file" name="user[avatar]" id="user_avatar" class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage"><span class="for-screen-reader">Upload avatar</span></div><div class="btn avatar input--file txt-xx-large"><img src="<%= asset("default-avatar.svg") %>" aria-hidden="true" data-upload-preview-target="image"><span class="for-screen-reader">Avatar</span></div></label></fieldset><div class="flex align-center gap"><%= translate("user_name") %><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="text" name="user[name]" id="user_name" class="input" autocomplete="name" placeholder="Name" required autofocus data-1p-ignore="true"><img src="<%= asset("person.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div><div class="flex align-center gap"><%= translate("email_address") %><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="email" name="user[email_address]" id="user_email_address" class="input" autocomplete="username" placeholder="Email address" required ><img src="<%= asset("email.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div><div class="flex align-center gap"><%= translate("password") %><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="password" name="user[password]" id="user_password" class="input" autocomplete="new-password" placeholder="Password" required maxlength="72"><img src="<%= asset("password.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div><button class="btn btn--reversed center txt-large" type="submit"><img src="<%= asset("check.svg") %>" aria-hidden="true"><span class="for-screen-reader">Save</span></button></div></section></form><%~ partials.help_contact(dot) %><%~ partials.layout_end(dot) %>