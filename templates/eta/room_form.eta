<%~ partials.layout_start(dot) %><% if (dot?.Room?.Type == "Rooms::Direct") { %><% if (dot?.Room?.ID) { %><%~ partials.direct_edit(dot) %><% } else { %><%~ partials.direct_new(dot) %><% } %><% } else { %>
<section class="panel txt-align-center" style="view-transition-name: <% if (dot?.Room?.ID) { %>edit-room-<%= dot?.Room?.ID %><% } else { %>new-room<% } %>"><form method="post" action="/rooms/<% if (dot?.Room?.Type == "Rooms::Open") { %>opens<% } else { %>closeds<% } %><% if (dot?.Room?.ID) { %>/<%= dot?.Room?.ID %><% } %>" accept-charset="UTF-8"><% if (dot?.Room?.ID) { %><input type="hidden" name="_method" value="patch"><% } %><div class="flex align-center gap"><% if (dot?.CanAdminister) { %><%= translate("room_name") %><label class="flex-item-grow txt-large"><input name="room[name]" id="room_name" class="input full-width" required autofocus placeholder="Name the room" data-turbo-permanent="true" data-action="keydown.enter->form#submit:prevent" type="text" value="<%= dot?.Room?.Name %>"><span class="for-screen-reader">Name this room</span></label><% } else { %><h1 class="flex-item-grow txt-x-large"><%= dot?.Room?.Name %></h1><% } %></div><hr class="margin-block borderless"><section class="room-access margin-block pad-inline fill-shade border-radius"><menu class="flex flex-column gap margin-none pad overflow-y constrain-height" data-controller="filter" data-filter-active-class="filter--active" data-filter-selected-class="selected">
<% if ((dot?.CanAdminister || (dot?.Room?.Type == "Rooms::Open"))) { %><li class="flex align-center gap margin-none"><figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch"><img aria-hidden="true" class="colorize--black" style="background-color: transparent" src="<%= asset("everyone.svg") %>"><span class="for-screen-reader">Everyone</span></figure><div class="min-width"><div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div></div><hr class="separator" aria-hidden="true"><% if (dot?.CanAdminister) { %><a class="btn--faux flex-inline" tabindex="-1" data-turbo-action="replace" href="/rooms/<% if (dot?.Room?.Type == "Rooms::Open") { %>closeds<% } else { %>opens<% } %>/<% if (dot?.Room?.ID) { %><%= dot?.Room?.ID %>/edit<% } else { %>new<% } %>"><label for="room_type" class="switch"><input type="checkbox" id="room_type" class="switch__input" <% if (dot?.Room?.Type == "Rooms::Open") { %>checked<% } %>><span class="switch__btn round"></span><span class="for-screen-reader"><% if (dot?.Room?.Type == "Rooms::Open") { %>Give only some access to this room<% } else { %>Give everyone access to this room<% } %></span></label></a><% } %></li><hr class="separator full-width" style="--border-style: solid"><% } %>
<% if (len(dot?.Users) > 20) { %><input type="search" id="search" autocorrect="off" autocomplete="off" data-1p-ignore="true" class="input input--transparent full-width" placeholder="Filter…" data-action="input->filter#filter"><% } %>
<div data-filter-target="list" contents><% const page = dot %><% for (const [memberIndex, member] of each(dot?.Users).entries()) { %><% const i = memberIndex %><% if ((page?.UserDivider && (i == page?.UserDivider))) { %><hr class="separator full-width" style="--border-style: solid"><% } %><li class="flex align-center gap margin-none" data-value="<%= lower(member?.Name) %>"><figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch"><a title="<%= member?.Title %>" class="btn avatar" data-turbo-frame="_top" href="/users/<%= member?.ID %>"><img aria-hidden="true" loading="lazy" src="<%= avatar(member?.ID, member?.UpdatedAt) %>" width="48" height="48"></a></figure><div class="min-width"><div class="overflow-ellipsis fill-shade"><strong><%= member?.Name %></strong></div></div><hr class="separator" aria-hidden="true"><% if (page?.CanAdminister) { %><% if (((page?.Room?.Type == "Rooms::Open") || (((member?.ID == page?.User?.ID) && (!page?.Room?.ID))))) { %><% if (page?.Room?.Type != "Rooms::Open") { %><input type="hidden" name="user_ids[]" value="<%= member?.ID %>"><% } %><img class="colorize--black flex-item-no-shrink" aria-hidden="true" src="<%= asset("check.svg") %>" width="20" height="20"><% } else { %><label class="switch flex-item-no-shrink"><input type="checkbox" name="user_ids[]" value="<%= member?.ID %>" class="switch__input" <% if (get(page?.Selected, member?.ID)) { %>checked<% } %>><span class="switch__btn round"></span><span class="for-screen-reader">Give <%= member?.Name %> access to this room</span></label><% } %><% } %></li><% } %></div></menu></section><% if (dot?.CanAdminister) { %><button name="button" type="submit" class="btn btn--reversed txt-large center"><img aria-hidden="true" src="<%= asset("check.svg") %>" width="20" height="20"><span class="for-screen-reader">Save</span></button><% } %></form></section>
<% if ((dot?.Room?.ID && dot?.CanAdminister)) { %><section class="panel txt-align-center"><form class="button_to" method="post" action="/rooms/<%= dot?.Room?.ID %>"><input type="hidden" name="_method" value="delete"><button class="btn btn--negative max-width" aria-label="Delete <%= dot?.Room?.Name %>" data-turbo-confirm="Are you sure you want to delete this room and all messages in it? This can’t be undone." type="submit"><img src="<%= asset("trash.svg") %>" aria-hidden="true" width="20" height="20"><span class="overflow-ellipsis"><%= dot?.Room?.Name %></span></button></form></section><% } %>
<% } %><%~ partials.layout_end(dot) %>