<turbo-frame data-controller="turbo-frame" data-action="notifications:ready@window-&gt;turbo-frame#load" data-turbo-frame-url-param="/rooms/<%= dot?.Room?.ID %>/involvement" id="<%= (dot?.Room).DOM("involvement") %>"><form class="button_to" method="post" action="/rooms/<%= dot?.Room?.ID %>/involvement?involvement=<%= nextInvolvement(dot?.Room?.Type, dot?.Involvement) %>"><input type="hidden" name="_method" value="put"><button role="checkbox" aria-checked="true" aria-labelledby="<%= (dot?.Room).DOM("involvement_label") %>" tabindex="0" class="btn <%= dot?.Involvement %>" type="submit"><img src="<%= asset(printf("notification-bell-%s.svg", dot?.Involvement)) %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader" id="<%= (dot?.Room).DOM("involvement_label") %>"><%= humanInvolvement(dot?.Involvement) %></span></button></form></turbo-frame>