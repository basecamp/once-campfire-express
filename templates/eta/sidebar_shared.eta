<a class="align-center gap room btn txt-nowrap<% if (dot?.Unread) { %> unread<% } %>" data-rooms-list-target="room" data-badge-dot-target="unread" data-sorted-list-target="item" data-room-id="<%= dot?.ID %>" data-sorted-list-name="<%= dot?.Name %>" id="<%= dot.DOM("list") %>" style="--column-gap: 0.5em" href="/rooms/<%= dot?.ID %>"><span class="overflow-ellipsis"><%= dot?.Name %></span></a>