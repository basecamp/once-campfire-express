<%~ partials.layout_start(dot) %><section class="panel txt-align-center"><div class="flex flex-column gap <% if (dot?.Subject?.Status == 2) { %>banned<% } %>"><div class="avatar txt-xx-large center" style="background: white"><img src="<%= avatar(dot?.Subject?.ID, dot?.Subject?.UpdatedAt) %>" alt="Profile avatar" class="avatar"></div>
<% if (dot?.Subject?.Role == 2) { %><div class="pad-double--inline push--inline push--block-start"><% if (dot?.Subject?.Status == 0) { %><form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%= dot?.Subject?.ID %>"><button class="btn btn--primary full-width txt--large"><img src="<%= asset("messages.svg") %>"></button></form><% } else { %><div><%= dot?.Subject?.Name %> is no longer on this account</div><% } %></div>
<% } else if (dot?.Subject?.Status == 1) { %><div><h1 class="txt-x-large margin-none"><%= dot?.Subject?.Name %></h1><div><%= dot?.Subject?.Name %> is no longer on this account</div></div>
<% } else { %><div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)"><h1 class="txt-x-large txt-tight-lines margin-none"><%= dot?.Subject?.Name %></h1><% if (((dot?.User?.Role == 1) && (dot?.Subject?.Role != 2))) { %><div><a href="mailto:<%= dot?.Subject?.Email %>"><%= dot?.Subject?.Email %></a></div><% } %><div><%= dot?.Subject?.Bio %></div></div>
<% if (dot?.Subject?.Status == 0) { %><div class="pad-inline-double margin-inline margin-block-start"><form method="post" action="/rooms/directs?user_ids%5B%5D=<%= dot?.Subject?.ID %>"><button class="btn btn--reversed full-width txt-large"><img src="<%= asset("messages.svg") %>" aria-hidden="true" aria-label="Ping <%= dot?.Subject?.Name %>"></button></form></div><% if (((dot?.User?.Role == 1) && (dot?.Subject?.Role != 2))) { %><hr class="margin-block-start borderless"><%~ partials.transfer_link(dot) %><% } %><% } %>
<% if ((((dot?.User?.Role == 1) && (dot?.User?.ID != dot?.Subject?.ID)) && (dot?.Subject?.Role != 2))) { %><div class="margin-block-start"><form method="post" action="/users/<%= dot?.Subject?.ID %>/ban"><% if (dot?.Subject?.Status == 2) { %><input type="hidden" name="_method" value="delete"><% } %><button class="btn full-width<% if (dot?.Subject?.Status == 2) { %> btn--negative<% } %>" data-turbo-confirm="<% if (dot?.Subject?.Status == 2) { %>Are you sure you want to remove the ban on this user?<% } else { %>Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses.<% } %>"><img src="<%= asset("cancel.svg") %>" aria-hidden="true"><span><% if (dot?.Subject?.Status == 2) { %>Remove ban<% } else { %>Ban <%= dot?.Subject?.Name %><% } %></span></button></form></div><% } %><% } %></div></section><%~ partials.layout_end(dot) %>