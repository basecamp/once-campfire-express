<% const url = printf("%s/join/%s", dot?.Origin, dot?.Account?.JoinCode) %><div class="flex flex-column align-center gap"><label class="flex flex-column gap full-width" style="--row-gap: 0.5em"><strong id="invite_label" class="invite-label">Share to invite more people</strong><span class="flex align-center gap input input--actor fill-white"><img src="<%= asset("person-add.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"><input type="text" class="input" id="invite_url" value="<%= url %>" aria-labelledby="invite_label" readonly></span></label><div class="flex align-center gap"><a href="<%= qrpath(url) %>" class="btn" data-lightbox-target="image" data-action="lightbox#open" data-lightbox-url-value="<%= qrpath(url) %>"><span class="for-screen-reader">Show join link QR code</span><img src="<%= asset("qr-code.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"></a><button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= url %>"><span class="for-screen-reader">Copy join link</span><img src="<%= asset("copy-paste.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"></button><button class="btn" hidden data-controller="web-share" data-action="web-share#share" data-web-share-url-value="<%= url %>" data-web-share-title-value="Link to join Campfire" data-web-share-text-value="Hit this link to join me in Campfire and start chatting."><span class="for-screen-reader">Share join link</span><img src="<%= asset("share.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"></button><% if (dot?.User?.Role == 1) { %><form class="button_to" method="post" action="/account/join_code"><button class="btn btn--regenerate" type="submit"><img src="<%= asset("refresh.svg") %>" aria-hidden="true" width="20" height="20" class="colorize--black"><span class="for-screen-reader">Regenerate join link</span></button></form><% } %></div></div>