<% const page = dot %><% for (const item1 of each(dot?.Users)) { %><li class="flex align-center gap margin-none <% if (item1?.Status == 2) { %>banned<% } %>"><figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch"><a href="/users/<%= item1?.ID %>" title="<%= item1?.Title %>" class="btn avatar" data-turbo-frame="_top"><img src="<%= avatar(item1?.ID, item1?.UpdatedAt) %>" aria-hidden="true" loading="lazy" width="48" height="48"></a></figure><div class="min-width"><div class="overflow-ellipsis fill-shade"><strong><%= item1?.Name %></strong></div></div><hr class="separator" aria-hidden="true"><% if (((page?.User?.Role == 1) && (item1?.Status == 0))) { %><% if (item1?.Role != 2) { %><form data-controller="form" method="post" action="/account/users/<%= item1?.ID %>"><input type="hidden" name="_method" value="patch"><label class="btn txt-small flex-item-no-shrink" for="role_user_<%= item1?.ID %>"><span class="for-screen-reader">Role: <% if (item1?.Role == 1) { %>Administrator<% } else { %>Member<% } %></span><img src="<%= asset("crown.svg") %>" width="20" height="20" aria-hidden="true"><input type="hidden" name="user[role]" value="member"><input type="checkbox" name="user[role]" value="administrator" <% if (item1?.Role == 1) { %>checked<% } %> data-action="form#submit" hidden id="role_user_<%= item1?.ID %>" <% if (page?.User?.ID == item1?.ID) { %>disabled<% } %>></label></form><% } %><% if (page?.User?.ID != item1?.ID) { %><form class="button_to" method="post" action="/account/users/<%= item1?.ID %>"><input type="hidden" name="_method" value="delete"><button class="btn txt-small flex-item-no-shrink btn--negative" data-turbo-confirm="Are you sure you want to permanently remove this person from the account? This can’t be undone." type="submit"><img src="<%= asset("minus.svg") %>" width="20" height="20" aria-hidden="true"><span class="for-screen-reader">Delete <%= item1?.Name %></span></button></form><% } %><% } %><% if (page?.User?.ID == item1?.ID) { %><a href="/users/me/profile" class="btn txt-small flex-item-no-shrink" target="_top"><img src="<%= asset("pencil.svg") %>" width="20" height="20" aria-hidden="true"><span class="for-screen-reader">My settings</span></a><% } %></li><% } %>