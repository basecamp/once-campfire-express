<a class="direct<% if (dot?.Unread) { %> unread<% } %>" id="<%= dot.DOM("list") %>" data-sorted-list-number="<%= epoch(dot?.UpdatedAt) %>" data-rooms-list-target="room" data-badge-dot-target="unread" data-sorted-list-target="item" data-room-id="<%= dot?.ID %>" href="/rooms/<%= dot?.ID %>"><% if (len(dot?.Members) > 1) { %><div class="avatar__group"><% for (const [memberIndex, member] of each(dot?.Members).entries()) { %><% const i = memberIndex %><% if (i < 4) { %><span class="avatar"><img src="<%= avatar(member?.ID, member?.UpdatedAt) %>" width="20" height="20" aria-hidden="true"></span><% } %><% } %></div><% } else { %><% for (const item5 of each(dot?.Members)) { %><span class="avatar"><img src="<%= avatar(item5?.ID, item5?.UpdatedAt) %>" width="48" height="48" aria-hidden="true"></span><% } %><% } %><span class="direct__author flex align-center gap max-width min-width border-radius txt-small"><span class="txt-nowrap overflow-ellipsis"><span class="for-screen-reader">Ping with</span><%= dot?.Label %></span></span></a>