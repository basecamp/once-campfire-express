<% if (dot?.HelpContact?.ID) { %><div class="txt-align-center margin-block-double full-width"><a <%= helpMailto(dot?.HelpContact) %> class="btn center" title="Email <%= dot?.HelpContact?.Name %>"><img src="<%= asset("lifebuoy.svg") %>" aria-hidden="true"><span><%= dot?.HelpContact?.Email %></span></a><div class="txt-align-center center margin-block txt-subtle">Campfire&trade; version <span class="version-badge"><%= dot?.Version %></span></div></div><% } %>