<%~ partials.layout_start(dot) %><section class="panel"<% if (dot?.Subject?.ID) { %> style="view-transition-name: chat-bot-<%= dot?.Subject?.ID %>"<% } %>><form action="/account/bots<% if (dot?.Subject?.ID) { %>/<%= dot?.Subject?.ID %><% } %>" method="post" enctype="multipart/form-data" class="flex flex-column gap"><% if (dot?.Subject?.ID) { %><input type="hidden" name="_method" value="patch"><% } %><h1 class="for-screen-reader">Chat Bot Setup</h1><label class="align-center center avatar__form gap" data-controller="upload-preview"><div class="btn input--file"><img src="<%= asset("camera.svg") %>" aria-hidden="true" width="20" height="20"><input type="file" name="user[avatar]" id="user_avatar" class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage"><span class="for-screen-reader">Upload bot avatar</span></div><div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);"><img src="<% if (dot?.AvatarURL) { %><%= dot?.AvatarURL %><% } else { %><%= asset("default-bot-avatar.svg") %><% } %>" alt="Bot avatar" width="48" height="48" data-upload-preview-target="image"></div></label>
<div class="flex align-center gap"><%= translate("bot_name") %><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="text" name="user[name]" id="user_name" value="<%= dot?.Subject?.Name %>" class="input" autocomplete="name" placeholder="Name the bot" autofocus required data-1p-ignore="true"><img src="<%= asset("bot.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div>
<div class="flex align-center gap"><%= translate("webhook_url") %><label class="flex align-center gap flex-item-grow txt-large input input--actor"><input type="url" name="user[webhook_url]" id="user_webhook_url" value="<%= dot?.Webhook %>" class="input" placeholder="Webhook URL"><img src="<%= asset("web.svg") %>" aria-hidden="true" width="24" height="24" class="colorize--black"></label></div><button class="btn btn--reversed center txt-large" type="submit"><img src="<%= asset("check.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Save changes</span></button></form>
<% if (dot?.Subject?.ID) { %><hr class="separator full-width margin-block-double"><div class="flex align-center gap justify-space-between"><form action="/account/bots/<%= dot?.Subject?.ID %>" method="post"><input type="hidden" name="_method" value="delete"><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone."><img src="<%= asset("trash.svg") %>" aria-hidden="true" width="20" height="20"><img src="<%= asset("bot.svg") %>" aria-hidden="true" width="20" height="20"></button></form><form action="/account/bots/<%= dot?.Subject?.ID %>/key" method="post"><input type="hidden" name="_method" value="put"><button class="btn full-width txt--small btn--negative" aria-label="Generate a new key" data-turbo-confirm="Are you sure you want to change the bot key? All usage of this bot must be updated."><img src="<%= asset("refresh.svg") %>" aria-hidden="true" width="20" height="20"><img src="<%= asset("key.svg") %>" aria-hidden="true" width="20" height="20"></button></form></div><% } %></section><%~ partials.layout_end(dot) %>