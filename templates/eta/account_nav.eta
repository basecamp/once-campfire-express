<div class="flex-item-justify-start"><a class="btn" href="<%= dot?.BackPath %>"><img src="<%= asset("arrow-left.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Go Back</span></a></div><% if (dot?.User?.Role == 1) { %><div class="flex align-center gap flex-item-justify-end"><a href="/account/bots" class="btn" style="view-transition-name: chat-bots"><img src="<%= asset("bot.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Set up chat bots</span></a><a href="/account/custom_styles/edit" class="btn" style="view-transition-name: custom-styles"><img src="<%= asset("art.svg") %>" aria-hidden="true" width="20" height="20"><span class="for-screen-reader">Custom styles</span></a></div><% } %>