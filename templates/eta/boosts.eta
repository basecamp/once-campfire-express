<turbo-frame id="boosting_message_<%= dot?.ClientID %>"><div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0" data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe"><div class="flex-inline flex-wrap gap" id="boosts_message_<%= dot?.ClientID %>" data-turbo-streaming-target="container"><% for (const item3 of each(dot?.Boosts)) { %><%~ partials.boost(item3) %><% } %></div><turbo-frame id="new_boost_message_<%= dot?.ClientID %>"><div class="flex-inline message__boost-inline" data-controller="soft-keyboard"><a class="boost__action txt-small btn" action="soft-keyboard#open" href="/messages/<%= dot?.ID %>/boosts/new"><img aria-hidden="true" src="<%= asset("boost.svg") %>" width="20" height="20"><span class="for-screen-reader">Add a boost</span></a></div></turbo-frame></div></turbo-frame>